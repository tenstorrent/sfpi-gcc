   Each row records an exhaustive check, over every Dst bit pattern, of
   the load-then-store round trip for one format pair.

   RVTT_STOREFOLD_SINK_PAIR (lfmt, sfmt, verdict, divergence, license, arch)
     One store-sink admission row per proven (load Mod0, store Mod0)
     Dst round trip; license = FIRE (EQUAL pair) / LICENSED
     (denormal-flush class, -mtt-tensix-optimize-store-sink only) /
     REFUSE (any other divergence).  arch is the target the row was
     proven on (BH, WH or SHARED).  A pair with no row for the current
     target refuses store-fold-sink-format-unproven.  SRCB/SRCB has no
     row: its load and store may resolve to different formats.  */

/* BF16, 16-bit Dst layout: 254 mismatches / 65536 swept.  */
RVTT_STOREFOLD_SINK_PAIR (SFPMEM_MOD0_FMT_BF16, SFPMEM_MOD0_FMT_BF16, NOT_EQUAL, DENORMAL_FLUSH, LICENSED,
			  STOREFOLD_ARCH_SHARED)
/* FP16, 16-bit Dst layout: 2046 mismatches / 65536 swept.  */
RVTT_STOREFOLD_SINK_PAIR (SFPMEM_MOD0_FMT_FP16, SFPMEM_MOD0_FMT_FP16, NOT_EQUAL, DENORMAL_FLUSH, LICENSED,
			  STOREFOLD_ARCH_SHARED)
/* INT32 raw, Dst32b (BH): 0 mismatches / 4294967296 swept.  */
RVTT_STOREFOLD_SINK_PAIR (SFPMEM_MOD0_FMT_INT32, SFPMEM_MOD0_FMT_INT32, EQUAL, NONE, FIRE,
			  STOREFOLD_ARCH_BH)
/* FP32, Dst32b (BH): 16777214 mismatches / 4294967296 swept.  */
RVTT_STOREFOLD_SINK_PAIR (SFPMEM_MOD0_FMT_FP32, SFPMEM_MOD0_FMT_FP32, NOT_EQUAL, DENORMAL_FLUSH, LICENSED,
			  STOREFOLD_ARCH_BH)
/* INT32_SM, Dst32b (WH): 1 mismatch / 4294967296 swept.  */
RVTT_STOREFOLD_SINK_PAIR (SFPMEM_MOD0_FMT_INT32_SM, SFPMEM_MOD0_FMT_INT32_SM, NOT_EQUAL, NEGATIVE_ZERO, REFUSE,
			  STOREFOLD_ARCH_WH)
/* SRCB/SRCB has no row: runtime load/store resolutions may differ.  */
