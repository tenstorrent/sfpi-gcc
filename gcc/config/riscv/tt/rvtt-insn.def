// The _lv instructions MUST follow the non-live versions of the same instruction

// FN defines a builtin
// OVR defines an override
#ifndef RVTT_FN
#define RVTT_FN(a, b, c, d, e, f)
#endif

#ifndef RVTT_OVR
#define RVTT_OVR(a, b, c, d, e, f)
#endif

#define LV rvtt_insn_data::HAS_LV
#define CC(N) (uint32_t((N+0) ? (N+0) : 0xffff) << rvtt_insn_data::CC_MASK_SHIFT)
#define VOL rvtt_insn_data::VOLATILE
#define EXP rvtt_insn_data::EXPANDED
#define EMP rvtt_insn_data::EMPTY
#define NV rvtt_insn_data::HAS_VAR // inverted sense here

#define N rvtt_insn_data::op_t::NONE
#define R rvtt_insn_data::op_t::RUNTIME
#define M rvtt_insn_data::op_t::early (rvtt_insn_data::op_t::MOD)
#define XM rvtt_insn_data::op_t::early (rvtt_insn_data::op_t::XMOD)

#define U rvtt_insn_data::op_t::UNSIGNED
#define S rvtt_insn_data::op_t::SIGNED
#define E rvtt_insn_data::op_t::EITHER
#define CU rvtt_insn_data::op_t::checked (U)
#define CS rvtt_insn_data::op_t::checked (S)
#define CE rvtt_insn_data::op_t::checked (E)
#define EU rvtt_insn_data::op_t::early (U)
#define ES rvtt_insn_data::op_t::early (S)

// Args are (NAME, ISA, _SFX, TYPE, FLAGS, OPS)

// This is first
RVTT_FN (synth_opcode,       ,,USI_FTYPE_USI_USI,                                            0, ({U, 0}, {U, 0}))
RVTT_FN (lreg_pressure,      ,,VOID_FTYPE_USI,                                               VOL|EMP, ({U, 1}))

// These builtins are expanded to something else during compilation
RVTT_FN (sfpxlogic,          ,,USI_FTYPE_USI_USI_USI,                                        VOL, ({XM, 0xf}, {R}, {R}))
RVTT_FN (sfpxpred,           ,,USI_FTYPE_USI_USI,                                            VOL|EMP, ({XM, 0xb7}, {R}))
RVTT_FN (sfpxcond,           ,,USI_FTYPE_USI_USI_USI,                                        VOL, ({XM, 0x1}, {R}, {R}))
RVTT_FN (sfpxcmp,            ,,USI_FTYPE_XTT_VEC_XTT_VEC_USI,                                CC(), ({XM, 0x3f}, {}))
RVTT_FN (sfpxloadi,          ,,XTT_VEC_FTYPE_XTT_IPTR_USI_USI_USI_SI,                        0, ({E, 0}, {ES, 6, 0}))

// If you're putting in nops, you want them preserved, so say it's volatile
RVTT_FN (sfpnop,             ,,VOID_FTYPE,                                                   VOL, ())
RVTT_FN (sfpbankdone,     qsr,,VOID_FTYPE_USI_USI_USI,                                       VOL, ({CU, 1}, {CU, 1}, {CU, 1}))

RVTT_FN (sfpreadlreg,        ,,XTT_VEC_FTYPE_USI,                                            EMP, ({CU, 4}))
RVTT_FN (sfpwritelreg,       ,,VOID_FTYPE_XTT_VEC_USI,                                       VOL|EMP, ({CU, 3}))
// Metadata only: follows an opaque raw instruction region to release LREG
// ownership and/or declare newly written LREGs.  Operand 0 is a
// release/last-use mask, operand 1 a write mask.  Not EMP: it emits nothing
// (length 0) but must survive as an RTL insn until the lreg-livein pass
// (rtl-rvtt-lreg-livein.cc) recognises it.
RVTT_FN (sfprawlreg_access,  ,,VOID_FTYPE_USI_USI,                                           VOL, ({CU, 8}, {CU, 8}))
// Metadata only: bracket an opaque raw instruction region with a trusted
// effects declaration.  Operand 0 of the begin marker is the mask of
// SFPCONFIG destinations 0..15 the region writes (bit 15, LaneConfig, may
// not be claimed); operand 1 is reserved and must be 0.  The region must
// not read or write any other PRGM register, and both markers must be in
// the same basic block as the statements they cover.  The declaration is
// trusted, not verified.
RVTT_FN (ttregion_begin,     ,,VOID_FTYPE_USI_USI,                                           VOL, ({CU, 16}, {CU, 8}))
RVTT_FN (ttregion_end,       ,,VOID_FTYPE,                                                   VOL, ())
// Metadata only: describe the LREG inputs (operand 0, a use mask) and
// outputs (operand 1) of the immediately preceding opaque raw instruction.
// The lreg-livein pass carries each use back to its reaching definition or
// function entry; a written LREG is reserved only if a later read needs it,
// and its old value is added as an input where disabled lanes keep it.

RVTT_FN (sfpnovalue,         ,,XTT_VEC_FTYPE,                                                0, ())
RVTT_FN (sfpselect2,         ,,XTT_VEC_FTYPE_XTT_VEC2_USI,                                   0, ({CU, 1}))
RVTT_FN (sfpselect4,         ,,XTT_VEC_FTYPE_XTT_VEC4_USI,                                   0, ({CU, 2}))
RVTT_FN (sfpselect8,         ,,XTT_VEC_FTYPE_XTT_VEC8_USI,                                   0, ({CU, 3}))
RVTT_FN (sfpconcat2,         ,,XTT_VEC2_FTYPE_XTT_VEC_XTT_VEC,                               0, ())

RVTT_FN (sfpsetcc,        ,_wh,VOID_FTYPE_XTT_VEC_USI,                                       CC(), ({M, 0x55}))
RVTT_OVR(sfpsetcc,        qsr,,VOID_FTYPE_XTT_VEC_USI_USI,                                   CC(), ({M, 0x55}, {U, 1}))
RVTT_FN (sfpencc,            ,,VOID_FTYPE_USI_USI,                                           CC(), ({M, 0x707}, {U, 2}))
// The operand checks above are in (imm12, mod1) order, but expansion maps
// arg1 to the insn's mod1 operand and arg2 to imm12.  Compiler-built calls
// (gimple-rvtt-cc.cc) use the expansion order and are created after the
// checks run; the compiler's all-lanes enable uses sfpencc_all_lanes.
RVTT_FN (sfpcompc,           ,,VOID_FTYPE,                                                   CC(), ())
RVTT_FN (sfppushc,           ,,VOID_FTYPE_USI,                                               VOL|CC(0x2000), ({M, 0xffff}))
RVTT_FN (sfppopc,            ,,VOID_FTYPE_USI,                                               VOL|CC(), ({M, 0xffff}))

// sfpassign is a placeholder to allow describing some combines
// simply -- that pass then elides any actual uses.  Marked as empty because they often go away.
RVTT_FN (sfpassign,          ,,XTT_VEC_FTYPE_XTT_VEC,                                        EMP, ())
RVTT_FN (sfpassign_lv,       ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC,                                LV|EMP, ())

RVTT_FN (sfploadi,           ,,XTT_VEC_FTYPE_XTT_IPTR_USI_USI_USI_USI,                       0, ({E, 16, 0}, {M, 0x17}))
RVTT_FN (sfploadi_lv,        ,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI,               LV, ({U, 16, 0}, {M, 0x517}))

// Although sfpmov permits 0x107 for mask bits, only 0x2 makes sense here -- all other cases should be expressed differently
RVTT_FN (sfpmov,             ,,XTT_VEC_FTYPE_XTT_VEC_USI,                                    0, ({M, 0x2}))
RVTT_FN (sfpmov_lv,          ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                            LV, ({M, 0x2}))
RVTT_FN (sfpexexp,           ,,XTT_VEC_FTYPE_XTT_VEC_USI,                                    CC(0xf0c), ({M, 0xf0f}))
RVTT_FN (sfpexexp_lv,        ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                            LV|CC(0xf0c), ({M, 0xf0f}))
RVTT_FN (sfpexman,           ,,XTT_VEC_FTYPE_XTT_VEC_USI,                                    0, ({M, 0x3}))
RVTT_FN (sfpexman_lv,        ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                            LV, ({M, 0x3}))
RVTT_FN (sfpabs,             ,,XTT_VEC_FTYPE_XTT_VEC_USI,                                    0, ({M, 0x3}))
RVTT_FN (sfpabs_lv,          ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                            LV, ({M, 0x3}))
RVTT_FN (sfplz,              ,,XTT_VEC_FTYPE_XTT_VEC_USI,                                    CC(0x4444), ({M, 0x5555}))
RVTT_FN (sfplz_lv,           ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                            LV|CC(0x4444), ({M, 0x5555}))

RVTT_FN (sfpand,             ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC,                                0, ())
RVTT_OVR(sfpand,           bh,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC,                                0, ())
RVTT_FN (sfpand_lv,          ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC,                        LV, ())
RVTT_OVR(sfpand_lv,        bh,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC,                        LV, ())
RVTT_FN (sfpor,              ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC,                                0, ())
RVTT_OVR(sfpor,            bh,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC,                                0, ())
RVTT_FN (sfpor_lv,           ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC,                        LV, ())
RVTT_OVR(sfpor_lv,         bh,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC,                        LV, ())
RVTT_FN (sfpxor,             ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC,                                0, ())
RVTT_FN (sfpxor_lv,          ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC,                        LV, ())
RVTT_FN (sfpnot,             ,,XTT_VEC_FTYPE_XTT_VEC,                                        0, ())
RVTT_FN (sfpnot_lv,          ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC,                                LV, ())

RVTT_FN (sfpshft_v,          ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                            0, ({M, 0x1}))
RVTT_OVR(sfpshft_v,    bh_qsr,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                            0, ({M, 0x5}))
RVTT_FN (sfpshft_v_lv,       ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC_USI,                    LV, ({M, 0x1}))
RVTT_OVR(sfpshft_v_lv, bh_qsr,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC_USI,                    LV, ({M, 0x5}))
RVTT_FN (sfpshft_i,          ,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI,               0, ({S, 12, 12}, {M, 0x1}))
RVTT_OVR(sfpshft_i,    bh_qsr,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI,               0, ({S, 12, 12}, {M, 0x5}))
RVTT_FN (sfpshft_i_lv,       ,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_XTT_VEC_USI_USI_USI_USI,       LV, ({S, 12, 12}, {M, 0x1}))
RVTT_OVR(sfpshft_i_lv, bh_qsr,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_XTT_VEC_USI_USI_USI_USI,       LV, ({S, 12, 12}, {M, 0x5}))

RVTT_FN (sfplut,              ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_USI,            0, ({M, 0x0011}))
RVTT_OVR(sfplut,       qsr,_qsr,XTT_VEC_FTYPE_XTT_VEC_USI,                                    0, ({M, 0x0011}))
RVTT_FN (sfplutfp32,       qsr,,XTT_VEC_FTYPE_XTT_VEC_USI,                                    0, ({M, 0x44dd}))
RVTT_FN (sfplutfp32_3r,  wh_bh,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_USI,            0, ({M, 0x4400}))
// Mod values {0,2,3} select the FP32-3ENTRY/FP16-6ENTRY-T1/T2 tables and +4
// is SGN_RETAIN.  Bit 3 (indirect destination via LReg7) is refused because
// the pattern encodes the destination directly.  Quasar keeps the narrower
// set in the sfplutfp32 entry above.
RVTT_FN (sfplutfp32_6r,  wh_bh,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_USI, 0, ({M, 0x00dd}))

RVTT_FN (sfpswap,          ,_wh,XTT_VEC2_FTYPE_XTT_VEC_XTT_VEC_USI,                          0, ({M, 0x1ff}))
RVTT_OVR(sfpswap,          qsr,,XTT_VEC2_FTYPE_XTT_VEC_XTT_VEC_USI_USI,                      0, ({M, 0x1ff}, {U, 1}))
RVTT_FN (sfptransp,           ,,XTT_VEC8_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC, 0, ())
// SFPSWAP with IndexEn, which also swaps the L4--L7 companions.
RVTT_FN (sfpswap_indexed,     ,,XTT_VEC4_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_USI,          0, ({M, 0x1ff}))
// SFPTRANSP of both banks that returns only L0--L3.
RVTT_FN (sfptransp8,          ,,XTT_VEC4_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC, 0, ())
// Compiler-internal (formed by the transp-involution pass): SFPTRANSP, four
// constant-address SFPLOADs into L0-L3, SFPTRANSP, kept as one insn because
// the net effect on the L4-L7 companion bank is the identity.  Args:
// addr0..addr3, mod0, addr_mode.  The RTL insn has an extra leading
// all-lanes-enable operand that this builtin always sets to 0; the pass
// emits any needed enable as a separate SFPENCC.
RVTT_FN (sfptransp_gather,    ,,XTT_VEC4_FTYPE_USI_USI_USI_USI_USI_USI,                      VOL, ({CU, 13}, {CU, 13}, {CU, 13}, {CU, 13}, {CU, 4}, {CU, 3}))
RVTT_FN (sfpshft2_copy4,      ,,XTT_VEC4_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC_USI,                  0, ({M, 0x1}))
RVTT_FN (sfpshft2_subvec_copy4, ,,XTT_VEC4_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_USI,        0, ({M, 0x2}))
RVTT_FN (sfpshft2_subvec_shfl1_copy4, ,,XTT_VEC4_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC_XTT_VEC_USI,  0, ({M, 0x4}))
RVTT_FN (sfpshft2_subvec_shfl1, ,,XTT_VEC_FTYPE_XTT_VEC_USI,                                 0, ({M, 0x18}))
RVTT_FN (sfpshft2_subvec_shfl1_lv, ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                      LV, ({M, 0x18}))

// loads can change rwc depending on unobserved state :(
RVTT_FN (sfpload,              ,,XTT_VEC_FTYPE_XTT_IPTR_USI_USI_USI_USI_USI,                 VOL, ({CE, 14}, {M, 0xffff}, {CU, 2}))
RVTT_OVR(sfpload,            bh,,XTT_VEC_FTYPE_XTT_IPTR_USI_USI_USI_USI_USI,                 VOL, ({CE, 13}, {M, 0xcfff}, {CU, 3}))
RVTT_OVR(sfpload,           qsr,,XTT_VEC_FTYPE_XTT_IPTR_USI_USI_USI_USI_USI,                 VOL, ({CE, 10}, {M, 0xcfff}, {CU, 3}))
RVTT_FN (sfploaddiscard,       ,,VOID_FTYPE_USI_USI_USI,                                     VOL, ({CE, 14}, {M, 0xffff}, {CU, 2}))
RVTT_OVR(sfploaddiscard,     bh,,VOID_FTYPE_USI_USI_USI,                                     VOL, ({CE, 13}, {M, 0xcfff}, {CU, 3}))
RVTT_OVR(sfploaddiscard,    qsr,,VOID_FTYPE_USI_USI_USI,                                     VOL, ({CE, 10}, {M, 0xcfff}, {CU, 3}))
RVTT_FN (sfpload_lv,           ,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI,         VOL|LV, ({CE, 14}, {M, 0xffff}, {CU, 2}))
RVTT_OVR(sfpload_lv,         bh,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI,         VOL|LV, ({CE, 13}, {M, 0xcfff}, {CU, 3}))
RVTT_OVR(sfpload_lv,        qsr,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI,         VOL|LV, ({CE, 10}, {M, 0xcfff}, {CU, 3}))
RVTT_FN (sfploadsrcs,       qsr,,XTT_VEC_FTYPE_XTT_IPTR_USI_USI_USI_USI_USI_USI,             VOL, ({CE, 10}, {M, 0xcfff}, {CU, 3}, {CU, 1}))
RVTT_FN (sfploadsrcs_lv,    qsr,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI_USI,     VOL|LV, ({CE, 10}, {M, 0xcfff}, {CU, 3}, {CU, 1}))
RVTT_FN (sfpstore,             ,,VOID_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI,            VOL, ({CE, 14}, {M, 0xffff}, {CU, 2}))
RVTT_OVR(sfpstore,           bh,,VOID_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI,            VOL, ({CE, 13}, {M, 0xcfff}, {CU, 3}))
RVTT_OVR(sfpstore,          qsr,,VOID_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI,            VOL, ({CE, 10}, {M, 0xcfff}, {CU, 3}))
RVTT_FN (sfpstoresrcs,      qsr,,VOID_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI_USI,        VOL, ({CE, 10}, {M, 0xcfff}, {CU, 3}, {CU, 1}))

// Not all mod values are commutative -- might be a subtract
RVTT_FN (sfpiadd_v,            ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                          EXP|CC(0x505), ({M, 0x555}, {}))
RVTT_FN (sfpiadd_v_lv,         ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC_USI,                  EXP|LV|CC(0x505), ({M, 0x555}, {}))
RVTT_FN (sfpiadd_i,            ,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI,             EXP|CC(0x101), ({S, 12, 12}, {M, 0x111}))
RVTT_FN (sfpiadd_i_lv,         ,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_XTT_VEC_USI_USI_USI_USI,     EXP|LV|CC(0x101), ({S, 12, 12}, {M, 0x111}))

// gimple-rvtt-combine requires this ordering
RVTT_FN (sfpmul,               ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                          0, ({M, 0x1}))
