# -*- makefile -*- tt makefile fragment

MULTILIB_OPTIONS := \
mcpu=tt-wh/mcpu=tt-bh/mcpu=tt-qsr32/mcpu=tt-qsr64 \
mabi=ilp32/mabi=lp64 \

MULTILIB_MATCHES := \
mcpu?tt-wh=mcpu?tt-wh-tensix \
mcpu?tt-bh=mcpu?tt-bh-tensix \
mcpu?tt-qsr32=mcpu?tt-qsr32-tensix \
mcpu?tt-qsr32=mcpu?tt-qsr32-tensixbh \
mcpu?tt-qsr64=mcpu?tt-qsr64-rocc \

MULTILIB_REQUIRED := \
mcpu=tt-wh/mabi=ilp32 \
mcpu=tt-bh/mabi=ilp32 \
mcpu=tt-qsr32/mabi=ilp32 \
mcpu=tt-qsr64/mabi=lp64 \

MULTILIB_OSDIRNAMES := \
mcpu.tt-wh/mabi.ilp32=!wh-ilp32 \
mcpu.tt-bh/mabi.ilp32=!bh-ilp32 \
mcpu.tt-qsr32/mabi.ilp32=!qsr32-ilp32 \
mcpu.tt-qsr64/mabi.lp64=!qsr64-lp64 \

MULTILIB_REUSE :=
MULTILIB_DIRNAMES :=
MULTILIB_EXCEPTIONS :=
MULTILIB_EXTRA_OPTS :=

RVTT_OBJS := rvtt.o \
	rvtt-effects.o \
	rvtt-raw-boundary.o \
	rvtt-macro-ownership.o \
	rvtt-macro-region.o \
	rvtt-macro-sched.o \
	rvtt-macro-desc.o \
	rvtt-macro-epoch.o \
	rvtt-macro-verify.o \
	rvtt-macro-tables.o \
	rvtt-mop-derive.o \
	gimple-rvtt-attrib.o \
	gimple-rvtt-cc.o \
	gimple-rvtt-ccmask.o \
	gimple-rvtt-int-abs.o \
	gimple-rvtt-check.o \
	gimple-rvtt-combine.o \
	gimple-rvtt-dce.o \
	gimple-rvtt-dst-iteration.o \
	gimple-rvtt-expand.o \
	gimple-rvtt-immvar.o \
	gimple-rvtt-invariant.o \
	gimple-rvtt-live.o \
	gimple-rvtt-lut-select.o \
	gimple-rvtt-crosscall.o \
	gimple-rvtt-crossloop.o \
	gimple-rvtt-reprprop.o \
	gimple-rvtt-transp-involution.o \
	gimple-rvtt-replay-unroll.o \
	gimple-rvtt-delivery-shape.o \
	rvtt-lut-tables.o \
	gimple-rvtt-lp-schedule.o \
	gimple-rvtt-noval.o \
	gimple-rvtt-prgm-const.o \
	gimple-rvtt-synth.o \
	gimple-rvtt-unspec.o \
	rtl-rvtt-dst-autoincr.o \
	rtl-rvtt-dst-ownership.o \
	rtl-rvtt-fix-ebreak.o \
	rtl-rvtt-fix-raw.o \
	rtl-rvtt-hll.o \
	rtl-rvtt-lreg-livein.o \
	rtl-rvtt-lreg-rename.o \
	rtl-rvtt-lp-alloc.o \
	rtl-rvtt-macro-planner.o \
	rtl-rvtt-mop-form.o \
	rtl-rvtt-replay.o \
	rtl-rvtt-rmext.o \
	rtl-rvtt-schedule.o \
	rtl-rvtt-spill-diag.o \
	rtl-rvtt-synth.o \
	rtl-rvtt-unspec.o \
	rvtt-lpsolve.o \
	rvtt-bnb.o \

OBJS += $(RVTT_OBJS)

$(RVTT_OBJS): %.o: $(srcdir)/config/riscv/tt/%.cc
	$(COMPILE) $<
	$(POSTCOMPILE)

rvtt-lpsolve.o: CXXFLAGS += $(LPSOLVE_CPPFLAGS)

gimple-rvtt-combine.o: rvtt-combine.inc

PASSES_EXTRA += $(srcdir)/config/riscv/tt/rvtt-passes.def

genprog += rvtt-combine

build/genrvtt-combine.o: $(srcdir)/config/riscv/tt/genrvtt-combine.cc

rvtt-combine.inc: build/genrvtt-combine$(build_exeext) $(srcdir)/config/riscv/tt/rvtt.gc
	$(RUN_GEN) $^ $@
