// Remember, these are tried in source order.

// integer a + 0 -> a
combine () {
  res|MU = sfpiadd_i_lv (0, lv, val, 0, 0, 0, SFPIADD_MOD1_CC_NONE);
  {}
  res = sfpassign_lv (lv, val);
}

namespace {
  bool all_uses_are (tree cst, gcall *res_call, rvtt_insn_data::insn_id id)
  {
    // It's expensive to synthesize, so only allow other uses if they're
    // all for sfpmul's, they'll share a synthesis.
    use_operand_p use_p;
    imm_use_iterator iter;
    FOR_EACH_IMM_USE_FAST (use_p, iter, cst)
      {
	gimple *g = USE_STMT (use_p);
	if (is_gimple_debug (g))
	  continue;
	if (g == res_call)
	  continue;
	
	auto insnd = rvtt_get_insn_data (g);
	if (!insnd || insnd->get_non_live ()->id != id)
	  return false;
      }

    return true;
  }
}

// ~ ~a -> a
combine () {
  tmp|OU = sfpnot_lv (lv1, val);
  res = sfpnot_lv (lv2, tmp);
  {}
  res = sfpassign_lv (lv2, val);
}

// - -a -> a
combine () {
  tmp|OU = sfpmov_lv (lv1, val, SFPMOV_MOD1_COMPL);
  res = sfpmov_lv (lv2, tmp, SFPMOV_MOD1_COMPL);
  {}
  res = sfpassign_lv (lv2, val);
}

// - [0,1,-1] -> [0,-1,1]
combine () {
  cst|OU|SA = sfpreadlreg (regno);
  res = sfpmov_lv (lv2, cst, SFPMOV_MOD1_COMPL);
  {
    auto ireg = TREE_INT_CST_LOW (regno);
    if (!(ireg == CREG_IDX_NEG_1
	  || ireg == CREG_IDX_1
	  || (ireg == CREG_IDX_0 && !flag_signed_zeros)))
      return false;
  }
  {
    auto ireg = TREE_INT_CST_LOW (regno);
    ireg = ireg == CREG_IDX_NEG_1 ? CREG_IDX_1
      : ireg == CREG_IDX_1 ? CREG_IDX_NEG_1
      : ireg;
    neg_regno = build_int_cst (TREE_TYPE (regno), ireg);
  }
  neg_cst = sfpreadlreg (neg_regno);
  res = sfpassign_lv (lv2, neg_cst);
}

// a * 1 -> a
combine () {
  one|OU|SA = sfpreadlreg (CREG_IDX_1);
  res = sfpmul_lv (lv, %a, one, 0);
  {}
  res = sfpassign_lv (lv, a);
}

// a * -1 -> -a
combine () {
  neg|OU|SA = sfpreadlreg (CREG_IDX_NEG_1);
  res = sfpmul_lv (lv, %a, neg, 0);
  {}
  res = sfpmov_lv (lv, a, SFPMOV_MOD1_COMPL);
}
combine () {
  neg|OU|SA = sfpreadlreg (CREG_IDX_NEG_1);
  res = sfpmul_lv (lv, neg, neg, 0);
  {}
  pos = sfpreadlreg (CREG_IDX_1);
  res = sfpassign_lv (lv, pos);
}

// a * 0 -> 0
combine () {
  { return flag_finite_math_only; }
  zero|OU|SA = sfpreadlreg (CREG_IDX_0);
  res = sfpmul_lv (lv, %a, zero, 0);
  {}
  res = sfpassign_lv (lv, zero);
}

// a + 0 -> a
combine () {
  { return !flag_signed_zeros; }
  zero|OU|SA = sfpreadlreg (CREG_IDX_0);
  res = sfpadd_lv (lv, %a, zero, 0);
  {}
  res = sfpassign_lv (lv, a);
}

// Do these in preference to mul,add->mad, as the register pressure is
// immediately reduced.  EXCEPTION (licensed, FABLE_GOES_BURR R3): a
// product dying into an add serializes two MAD-subunit roundings where
// the contract mad rule below delivers one; under BOTH license keys
// (-fassociative-math + -mtt-tensix-optimize-reassoc-mad-restructure)
// the fold is vetoed for exactly those pairs and the mad rule fuses
// them instead (madr_suppress_*_fold_p, gimple-rvtt-combine.cc).
// a * fp16b(scalar)
combine () {
  cst|SA|OU = sfploadi (ptr, val, var, id, SFPLOADI_MOD0_FLOATB);
  res = sfpmul_lv (lv, %a, cst, 0);
  {
    if (TREE_INT_CST_LOW (id)
	&& !all_uses_are (cst, res_call, rvtt_insn_data::sfpmul))
      return false;
    if (madr_suppress_mul_fold_p (res_call))
      return false;
  }
  res = sfpmuli_lv (ptr, lv, a, val, var, id, 0);
  {
    if (auto iid = TREE_INT_CST_LOW (id))
      addimuli.emplace_back (res_call, rvtt_get_insn_data (res_call), iid);
  }
}

// a + fp16b(scalar)
combine () {
  cst|SA|OU = sfploadi (ptr, val, var, id, SFPLOADI_MOD0_FLOATB);
  res = sfpadd_lv (lv, %a, cst, 0);
  {
    if (TREE_INT_CST_LOW (id)
	&& !all_uses_are (cst, res_call, rvtt_insn_data::sfpadd))
      return false;
    if (madr_suppress_add_fold_p (a, res_call))
      return false;
  }
  res = sfpaddi_lv (ptr, lv, a, val, var, id, 0);
  {
    if (auto iid = TREE_INT_CST_LOW (id))
      addimuli.emplace_back (res_call, rvtt_get_insn_data (res_call), iid);
  }
}

// -a * b
combine (BH_QSR) {
  p = sfpmov_lv (lv1, a, SFPMOV_MOD1_COMPL);
  r = sfpmul_lv (lv2, %p, b, mod);
  {}
  {
    unsigned imod = TREE_INT_CST_LOW (mod);
    if (commuted && imod)
      imod = (imod & SFPMAD_MOD1_BH_COMPL_A ? SFPMAD_MOD1_BH_COMPL_C : 0)
	| (imod & SFPMAD_MOD1_BH_COMPL_C ? SFPMAD_MOD1_BH_COMPL_A : 0);
    mod = build_int_cst (TREE_TYPE (mod),
			 imod ^ SFPMAD_MOD1_BH_COMPL_A);
  }
  r = sfpmul_lv (lv2, a, b, mod);
}

// -a + b
combine (BH_QSR) {
  p = sfpmov_lv (lv1, a, SFPMOV_MOD1_COMPL);
  r = sfpadd_lv (lv2, %p, b, mod);
  {}
  {
    unsigned imod = TREE_INT_CST_LOW (mod);
    if (commuted && imod)
      imod = (imod & SFPMAD_MOD1_BH_COMPL_A ? SFPMAD_MOD1_BH_COMPL_C : 0)
	| (imod & SFPMAD_MOD1_BH_COMPL_C ? SFPMAD_MOD1_BH_COMPL_A : 0);
    mod = build_int_cst (TREE_TYPE (mod),
			 imod ^ SFPMAD_MOD1_BH_COMPL_A);
  }
  r = sfpadd_lv (lv2, a, b, mod);
}

// a * b + c
combine () {
  p = sfpmul_lv (lv1, a, b, mul_mod);
  r = sfpadd_lv (lv2, %p, c, add_mod);
  {}
  {
    // For WH mul_mod and add_mod will be zero
    unsigned iadd_mod = TREE_INT_CST_LOW (add_mod);
    if (commuted && iadd_mod)
      iadd_mod = (iadd_mod & SFPMAD_MOD1_BH_COMPL_A ? SFPMAD_MOD1_BH_COMPL_C : 0)
	| (iadd_mod & SFPMAD_MOD1_BH_COMPL_C ? SFPMAD_MOD1_BH_COMPL_A : 0);

    mod = build_int_cst (TREE_TYPE (add_mod),
			 iadd_mod ^ TREE_INT_CST_LOW (mul_mod));
  }
  r = sfpmad_lv (lv2, a, b, c, mod);
}

// a * b + c, MULTI-USE mul -- THE LICENSED MAD FUSION (lane EJ).
// The default rule above is the sfpi single-use contract: the mul dies
// into the mad, every consumer sees one rounding.  When the mul has
// OTHER uses, fusing the add makes the add's consumers see the singly-
// rounded product while the mul's surviving consumers keep the doubly-
// rounded one -- a value divergence that only the reassociation
// license admits (owner ratification 2026-08-21): it fires ONLY under
// -fassociative-math AND -mtt-tensix-optimize-reassoc (REASSOC_FP =
// rvtt_reassoc_fp_licensed_p), keeps the mul for its other uses, and
// prints a named "reassoc:" dump line.  Single-use pairs defer to the
// default rule so the licensed flags never change the default path.
combine (REASSOC_FP) {
  p|OU = sfpmul_lv (lv1, a, b, mul_mod);
  r = sfpadd_lv (lv2, %p, c, add_mod);
  {
    // Defer single-use pairs to the default fuse rule byte-identically.
    gcall *allowed[1] = { r_call };
    if (!has_other_use (p, allowed, 1))
      return false;
    // Pressure budget: the kept mul adds one live range the default
    // (mul-dies) fusion would not; refuse when the block cannot prove
    // headroom (a licensed transform must never make a compilable
    // kernel uncompilable -- the corpus lreg-pressure finding).
    if (rvtt_pressure_bb_peak (gimple_bb (r_call)) + 1
	> rvtt_pressure_capacity ())
      {
	if (dump_file)
	  fprintf (dump_file,
		   "reassoc: refusing mad-fuse "
		   "(reassoc-pressure-budget-exceeded: kept multi-use mul "
		   "adds a live range beyond the 8-LREG budget)\n");
	return false;
      }
  }
  {
    if (dump_file)
      fprintf (dump_file,
	       "reassoc: licensed mad-fuse of multi-use mul (kept for its "
	       "other uses) (flag_associative_math && "
	       "-mtt-tensix-optimize-reassoc)\n");
    // For WH mul_mod and add_mod will be zero
    unsigned iadd_mod = TREE_INT_CST_LOW (add_mod);
    if (commuted && iadd_mod)
      iadd_mod = (iadd_mod & SFPMAD_MOD1_BH_COMPL_A ? SFPMAD_MOD1_BH_COMPL_C : 0)
	| (iadd_mod & SFPMAD_MOD1_BH_COMPL_C ? SFPMAD_MOD1_BH_COMPL_A : 0);

    mod = build_int_cst (TREE_TYPE (add_mod),
			 iadd_mod ^ TREE_INT_CST_LOW (mul_mod));
  }
  r = sfpmad_lv (lv2, a, b, c, mod);
}

// -a + b (WH)
combine (WH) {
  p = sfpmov_lv (lv1, a, SFPMOV_MOD1_COMPL);
  r = sfpadd_lv (lv2, %p, b, 0);
  {}
  {}
  n1 = sfpreadlreg (CREG_IDX_NEG_1);
  r = sfpmad_lv (lv2, a, n1, b, 0);
  {}
}

// -(a * b)
combine (BH_QSR) {
  p = sfpmul_lv (lv1, a, b, mod);
  r = sfpmov_lv (lv2, p, SFPMOV_MOD1_COMPL);
  {}
  {
    mod = build_int_cst (TREE_TYPE (mod),
			 TREE_INT_CST_LOW (mod) ^ SFPMAD_MOD1_BH_COMPL_A);
  }
  r = sfpmul_lv (lv2, a, b, mod);
}
// -(a + b)
combine (BH_QSR) {
  p = sfpadd_lv (lv1, a, b, mod);
  r = sfpmov_lv (lv2, p, SFPMOV_MOD1_COMPL);
  {}
  {
    mod = build_int_cst (TREE_TYPE (mod),
			 TREE_INT_CST_LOW (mod) ^ (SFPMAD_MOD1_BH_COMPL_A | SFPMAD_MOD1_BH_COMPL_C));
  }
  r = sfpadd_lv (lv2, a, b, mod);
}
// -(a * b + c)
combine (BH_QSR) {
  p = sfpmad_lv (lv1, a, b, c, mod);
  r = sfpmov_lv (lv2, p, SFPMOV_MOD1_COMPL);
  {}
  {
    mod = build_int_cst (TREE_TYPE (mod),
			 TREE_INT_CST_LOW (mod) ^ (SFPMAD_MOD1_BH_COMPL_A | SFPMAD_MOD1_BH_COMPL_C));
  }
  r = sfpmad_lv (lv2, a, b, c, mod);
}

// Xiadd_i, Xiadd_i -> Xiadd_i

// FIXME Overly tricky until we cleanup compares
combine () {
  sum|OU|SR = sfpiadd_i_lv (ptr, lv1, val, imm, var, id, sum_mod);
  res|MU = sfpxiadd_i_lv (0, lv2, sum, 0, 0, 0, res_mod);
  {
    gcc_assert (!res);

    // SUM_MOD can't set CC
    if (rvtt_get_insn_data (sum_call)->sets_cc (sum_call))
      return false;

    if (TREE_INT_CST_LOW (sum_mod) & SFPIADD_MOD1_ARG_2SCOMP_LREG_DST)
      return false;
  }
  {
    mod = build_int_cst (TREE_TYPE (sum_mod),
			 TREE_INT_CST_LOW (res_mod) & ~SFPXIADD_MOD1_IS_SUB);
  }
  sum = sfpxiadd_i_lv (ptr, lv1, val, imm, var, id, mod);
}

// setexp (man, exexp (z, Biased)) -> setexp-copy (man, z)
// SFPEXEXP NODEBIAS yields z's raw exponent field ((z >> 23) & 255) and sets
// no CC; SFPSETEXP mod1=LREG consumes exp & 0xFF while mod1=LREG_CPY consumes
// (exp >> 23) & 0xFF of the float encoding -- a bit-identical composition for
// every input, so consume z directly and let a single-use exexp die.  The
// combiner's same-BB/same-CC-region discipline keeps the lane masks of both
// instructions identical, which the equivalence requires.
// Gated: -mtt-tensix-optimize-setexp-fold (compiler-default ON, promoted
// after silicon validation; -mno-tt-tensix-optimize-setexp-fold disables).
combine (SETEXP_FOLD) {
  exp|OU = sfpexexp_lv (exp_lv, z, SFPEXEXP_MOD1_NODEBIAS);
  res = sfpsetexp_v_lv (lv, man, exp, SFPSETEXP_MOD1_LREG);
  {}
  res = sfpsetexp_v_lv (lv, man, z, SFPSETEXP_MOD1_LREG_CPY);
}

// exexp, Xiadd_i -> exexp
combine () {
  exp|OU|SR = sfpexexp_lv (exp_lv, a, exp_mod);
  res|MU = sfpxiadd_i_lv (0, add_lv, exp, 0, 0, 0, add_mod);
  {
    // EX_MOD can't set cc
    if (rvtt_get_insn_data (exp_call)->sets_cc (exp_call))
      return false;

    // check res_mod is cc-setting on sign bit
    auto imod = TREE_INT_CST_LOW (add_mod) & SFPXCMP_MOD1_CC_MASK;
    if (imod != SFPXCMP_MOD1_CC_LT
	&& imod != SFPXCMP_MOD1_CC_GE)
      return false;
    
  }
  {
    exp_mod = build_int_cst (TREE_TYPE (exp_mod),
			     TREE_INT_CST_LOW (exp_mod)
			     | SFPEXEXP_MOD1_SET_CC_SGN_EXP
			     | ((TREE_INT_CST_LOW (add_mod) & SFPXCMP_MOD1_CC_MASK)
				== SFPXCMP_MOD1_CC_GE
				? SFPEXEXP_MOD1_SET_CC_COMP_EXP : 0));
  }
  exp = sfpexexp_lv (exp_lv, a, exp_mod);
  res = sfpassign_lv (add_lv, exp);
}
