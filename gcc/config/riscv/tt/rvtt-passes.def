// Gimple passes
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_check_early);
/* The CC-mask fold rewrites structured single-zero-assign v_if regions
   into value-mask arithmetic.  It must run before the invariant pass so
   the removed CC statement no longer bars the loop's immediate hoists
   and the mask's live range is visible to the pressure proof, and
   before pass_rvtt_immvar_expand while the canonical structured forms
   are intact.  */
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_ccmask);
/* The integer-abs fold rewrites structured conditional-negate v_if
   regions into the single integer SFPABS, citing the exhaustive
   equivalence proof in tt/proofs/int-abs-negate-select/.  Same
   placement rationale as the ccmask fold above: run while the
   canonical structured forms are intact and before the invariant pass
   so the removed CC statement no longer bars the loop's hoists.  */
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_int_abs);
/* The one's-complement selection rewrites the all-ones-minus-x subtract
   into the single SFPNOT, citing the exhaustive equivalence proof in
   tt/proofs/int-not-allones-subtract/.  It runs before the invariant
   pass so the dead all-ones immediate is deleted instead of hoisted.  */
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_int_not);
/* The store fold forwards single-use lane merges into their consuming
   Dst stores (same-mask forwarding; proven-round-trip region sinks per
   tt/proofs/store-sink-roundtrip/) and carries the standing named
   refusal for the stochrnd-into-store candidate
   (tt/proofs/stochrnd-store-round/).  Same placement rationale as the
   folds above: run while the canonical structured forms are intact and
   before the invariant pass sees the shortened bodies.  */
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_store_fold);
/* Place semantic SFPU constants outside counted loops while values are still
   SSA pseudos.  Doing this after allocation would extend hard-LREG lifetimes.  */
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_invariant);
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_immvar_expand);
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_synth_split);

// Insert the bulk of these just before rtl expansion
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_check_late);
/* This runs after generic loop unrolling but before synth CSE and expansion,
   while logical Dst addresses and typed loads/stores are still explicit.  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_dst_iteration);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_immload_shorten);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_noval_elide);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_synth_cse);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_dce);
INSERT_PASS_BEFORE (pass_expand, 1, pass_dce);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_synth_renumber);
/* Select LUT instructions from range-dispatch trees while the trees'
   structured condition form (sfpxvif/sfpxcondb) is still explicit,
   i.e. before pass_rvtt_expand lowers it to raw CC side effects.  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_lut_select);
/* The cross-call prefix hoist runs right after LUT selection has formed
   the coefficient prefix and placed it in the callee's row-loop
   preheader, and before pass_rvtt_expand lowers the builtin forms.  It
   reads (and, on a complete proof, edits) the still-gimple bodies of
   the callee's callers -- callers expand after their callees, the same
   ordering fact the MOP outward-ownership proof relies on.  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_crosscall);
/* The cross-loop hoist lifts loop-invariant SFPU immediate
   materializations already sitting in a loop body (an inner loop's
   preheader placement) across ENCLOSING loops whose bodies deliver
   only audited-inert words -- the audited generalization of the
   opaque-region/sfpu-barrier refusals that stop the early invariant
   pass at the first delivered word.  It runs after the cross-call
   hoist has settled contract placements and before pass_rvtt_expand
   lowers the canonical builtin forms.  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_crossloop);
/* Representation propagation cancels audited conversion-involution
   pairs across choose-only value webs (SSA proof, bit-exact).  It
   runs after the synth CSE/DCE have canonicalized duplicate
   conversions and before pass_rvtt_expand lowers the structured CC
   forms, so the whole downstream pipeline -- including macro-planner
   region discovery -- sees the shorter bodies.  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_reprprop);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_expand);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_immload_combine);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_live);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_cc);
/* Programmable-constant allocation runs after the CC analysis and
   immediately before the combiner, so a rewritten immediate pair is
   re-offered to the existing mul+add->mad rule in the same pipeline.  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_prgm_const);
/* Licensed reassociation runs after the CC analysis (its chain window
   proof reads the explicit lowered CC writers) and immediately before
   the combiner, so a licensed rebalance's fresh add pairs are
   re-offered to the existing mul+add->mad rule in the same pipeline.
   Default off; FP sites additionally require -fassociative-math (the
   owner-ratified license, 2026-08-21) and refuse by name without it.  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_reassoc);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_combine);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_unspec_prop_ssa);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_attrib);
/* Interleave phase-2 fused Dst groups after RVTT lowering has exposed final
   opcode dependencies, but before RTL expansion and LREG allocation.  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_dst_interleave);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_lp_schedule);

/* Cross-lane canonical-frame fusion (rotate-chain collapse, per-arch
   slide re-lowering, swap refolding, transpose-involution and
   zip-round-trip cancellation): late, after the structured-CC lowering
   and scheduling shape are final -- the frame matchers and the
   all-lanes proof read explicit SFPENCC/PUSHC/POPC words -- and before
   the transpose-involution pass below so both see maximally-canonical
   streams.  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_crosslane);

/* Transpose-involution formation + Dst-park elision: late, after the
   structured-CC lowering and scheduling shape are final, so the
   operand-def windows and lane-state scan see the stream that will
   expand.  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_transp_involution);

/* Priced delivery-shape arbitration: annotation only (loop->unroll on
   proven-trip counted SFPU row loops, factor chosen by exact
   minimization over the measured delivery model; an affirmative rolled
   selection annotates factor 1 to own the decision slot).  Runs after
   every body-shaping gimple pass so its census and the fixed-factor
   request pass below see the same final pre-expansion stream, and
   BEFORE that pass: a solver decision (any nonzero loop->unroll)
   preempts the fixed-factor request, which never overrides an existing
   annotation.  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_delivery_shape);

/* Launch-flatten complete-unroll request (lane HH): annotation only
   (loop->unroll = the proven trip count on counted innermost DELIVERY
   loops -- typed replay records/launches, fixed raw .ttinsn words, typed
   SFPU builtins, own scalar control).  Placed immediately BEFORE the
   GIMPLE complete unroller, unlike the pre-expansion requests below: the
   pragma contract makes cunroll bypass its size estimate (which a typed
   spelling inflates ~13x over the raw words it lowers to) and fold every
   per-trip conditional at its proven value, so the flattened stream the
   replay former and the delivery passes see is the one a hand `#pragma
   GCC unroll' world has always given them.  */
INSERT_PASS_BEFORE (pass_complete_unroll, 1, pass_rvtt_launch_flatten);

/* Replay-window loop-unroll request: annotation only (loop->unroll on
   qualifying counted SFPU row loops, consumed by the generic RTL
   unroller so the always-on replay former can capture the row).  Runs
   after every statement-editing pass so its typed census sees the
   final pre-expansion statement stream (only the round-interleave
   annotation pass below follows it).  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_replay_unroll);

/* Round-chain interleave request: annotation only (unroll-by-two on
   counted SFPU round loops whose iterations are proven independent by
   dataflow; the cyclic extension of the post-RA list scheduler lifts
   the self-loop deferral for the doubled body).  Runs after the
   replay-loop-unroll request and never overrides its annotation.  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_round_interleave);

// RTL passes
INSERT_PASS_BEFORE (pass_lower_subreg, 1, pass_rvtt_unspec_prop_rtl);
INSERT_PASS_AFTER (pass_cse, 1, pass_rvtt_fix_ebreak);
INSERT_PASS_AFTER (pass_late_combine, 1, pass_rvtt_rmext);
/* Dst/RWC ownership runs first among the pre-IRA passes: folding a
   proven-identity Dst reload changes SFPU liveness, which the raw-LREG
   livein reservation below must observe in final form.  */
INSERT_PASS_BEFORE (pass_ira, 1, pass_rvtt_dst_ownership);
/* Pre-allocation pressure-cost list scheduling (default off) runs after
   the Dst/RWC ownership folds have settled final SFPU pseudo liveness
   and before the raw-LREG livein reservations and the LREG allocator
   observe the stream: reordering over pseudos is the seam where a
   ten-simultaneously-live instruction order can still become an
   eight-register-schedulable one.  */
INSERT_PASS_BEFORE (pass_ira, 1, pass_rvtt_lp_schedule_prera);
/* Observe final SFPU pseudo pressure after sched1 and early rematerialization,
   immediately before IRA.  This pass is dump-only until coloring enforcement
   has an independently validated grouped-change implementation.  */
INSERT_PASS_BEFORE (pass_ira, 1, pass_rvtt_lreg_livein);
INSERT_PASS_BEFORE (pass_ira, 1, pass_rvtt_lp_alloc);
/* Named SFPU spill diagnosis runs first after allocation, before any
   other Tensix RTL pass consumes the stream: an allocated XTT32SI
   memory move becomes a user error (lreg-pressure-exceeded) instead of
   the assembly-output ICE it used to be.  */
INSERT_PASS_BEFORE (pass_postreload, 1, pass_rvtt_spill_diag);
INSERT_PASS_BEFORE (pass_postreload, 1, pass_rvtt_synth_opcode);
/* The generic macro planner analyzes and forms macro regions after IRA
   has assigned LREGs, ahead of the hazard scheduler and replay
   formation.  (The quarantined exact-calendar pass it replaced was
   deleted at WP8.)  */
INSERT_PASS_BEFORE (pass_postreload, 1, pass_rvtt_macro_planner);
/* The LREG chain rename runs after allocation and macro formation and
   ahead of the hazard scheduler's fill passes, so a broken storage
   collision widens the fill candidate sets the same compilation.  */
INSERT_PASS_BEFORE (pass_postreload, 1, pass_rvtt_lreg_rename);
INSERT_PASS_BEFORE (pass_postreload, 1, pass_rvtt_schedule);
/* MOP loop-delivery formation re-rolls runs and counted loops of replay
   playback launches into the hardware MOP expander.  It must see the
   FINAL launch stream: after replay formation (hoist/unroll/conversion)
   AND after Dst auto-increment ownership has absorbed the per-row typed
   separators that would otherwise break launch runs.  Per the anchor
   rule below, this line precedes both and therefore RUNS AFTER both.  */
INSERT_PASS_AFTER (pass_postreload, 1, pass_rvtt_mop_form);
/* Dst auto-increment ownership must see the final replay structure: it
   absorbs the per-row typed TTINCRWC separators into an owned address
   modifier configuration, both around explicit rows and around replay
   launches.  Each later INSERT_PASS_AFTER on the same anchor lands closer to
   the anchor, so this line precedes the replay insertion below and therefore
   RUNS AFTER pass_rvtt_replay.  */
INSERT_PASS_AFTER (pass_postreload, 1, pass_rvtt_dst_autoincr);
/* Replay formation consumes the final explicit or macro issue stream.  */
INSERT_PASS_AFTER (pass_postreload, 1, pass_rvtt_replay);

// This pass should run as late as possible, ideally just before final.
// However, the machine reorg pass, when using -msave-restore, injects an insn
// that causes df_analyze to crash, so run before that And, free_cfg pass calls
// free_bb_for_insn resulting in problems w/ df_analyze, so call before that
INSERT_PASS_BEFORE (pass_free_cfg, 1, pass_rvtt_hll);
INSERT_PASS_BEFORE (pass_free_cfg, 1, pass_rvtt_fix_raw);
/* TEN-2932 ENABLE_DEST_INDEX window enforcement must see the FINAL
   stream -- after allocation (allocator-inserted moves ARE the caught
   violation class), the hazard scheduler, and replay/MOP formation --
   so it runs last among the Tensix RTL passes, right before free_cfg.
   Later lines land closer to the anchor, so this line runs after the
   two above.  */
INSERT_PASS_BEFORE (pass_free_cfg, 1, pass_rvtt_crosslane_window);
