// Gimple passes
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_check_early);
/* The CC-mask fold rewrites structured single-zero-assign v_if regions
   into value-mask arithmetic.  It must run before the invariant pass so
   the removed CC statement no longer bars the loop's immediate hoists
   and the mask's live range is visible to the pressure proof, and
   before pass_rvtt_immvar_expand while the canonical structured forms
   are intact.  */
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_ccmask);
/* The integer-abs fold rewrites structured conditional-negate v_if
   regions into the single integer SFPABS, citing the exhaustive
   equivalence proof in tt/proofs/int-abs-negate-select/.  Same
   placement rationale as the ccmask fold above: run while the
   canonical structured forms are intact and before the invariant pass
   so the removed CC statement no longer bars the loop's hoists.  */
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_int_abs);
/* The one's-complement selection rewrites the all-ones-minus-x subtract
   into the single SFPNOT, citing the exhaustive equivalence proof in
   tt/proofs/int-not-allones-subtract/.  It runs before the invariant
   pass so the dead all-ones immediate is deleted instead of hoisted.  */
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_int_not);
/* The store fold forwards single-use lane merges into their consuming
   Dst stores (same-mask forwarding; proven-round-trip region sinks per
   tt/proofs/store-sink-roundtrip/) and carries the standing named
   refusal for the stochrnd-into-store candidate
   (tt/proofs/stochrnd-store-round/).  Same placement rationale as the
   folds above: run while the canonical structured forms are intact and
   before the invariant pass sees the shortened bodies.  */
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_store_fold);
/* Place semantic SFPU constants outside counted loops while values are still
   SSA pseudos.  Doing this after allocation would extend hard-LREG lifetimes.  */
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_invariant);
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_immvar_expand);
INSERT_PASS_BEFORE (pass_all_optimizations, 1, pass_rvtt_synth_split);

// Insert the bulk of these just before rtl expansion
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_check_late);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_immload_shorten);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_noval_elide);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_synth_cse);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_dce);
INSERT_PASS_BEFORE (pass_expand, 1, pass_dce);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_synth_renumber);
/* Select LUT instructions from range-dispatch trees while the trees'
   structured condition form (sfpxvif/sfpxcondb) is still explicit,
   i.e. before pass_rvtt_vif lowers it to raw CC side effects.  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_lut_select);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_vif);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_immload_combine);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_live);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_cc);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_combine);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_schedule_ssa);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_unspec_prop_ssa);
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_attrib);




/* Launch-flatten complete-unroll request: annotation only
   (loop->unroll = the proven trip count on counted innermost DELIVERY
   loops -- typed replay records/launches, fixed raw .ttinsn words, typed
   SFPU builtins, own scalar control).  Placed immediately BEFORE the
   GIMPLE complete unroller, unlike the pre-expansion requests below: the
   pragma contract makes cunroll bypass its size estimate (which a typed
   spelling inflates ~13x over the raw words it lowers to) and fold every
   per-trip conditional at its proven value, so the flattened stream the
   replay former and the delivery passes see is the one a hand `#pragma
   GCC unroll' world has always given them.  */
INSERT_PASS_BEFORE (pass_complete_unroll, 1, pass_rvtt_launch_flatten);

/* Replay-window loop-unroll request: annotation only (loop->unroll on
   qualifying counted SFPU row loops, consumed by the generic RTL
   unroller so the always-on replay former can capture the row).  Runs
   after every statement-editing pass so its typed census sees the
   final pre-expansion statement stream (only the round-interleave
   annotation pass below follows it).  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_replay_unroll);

/* Round-chain interleave request: annotation only (unroll-by-two on
   counted SFPU round loops whose iterations are proven independent by
   dataflow; the cyclic extension of the post-RA list scheduler lifts
   the self-loop deferral for the doubled body).  Runs after the
   replay-loop-unroll request and never overrides its annotation.  */
INSERT_PASS_BEFORE (pass_expand, 1, pass_rvtt_round_interleave);

// RTL passes
INSERT_PASS_BEFORE (pass_lower_subreg, 1, pass_rvtt_unspec_prop_rtl);
INSERT_PASS_AFTER (pass_cse, 1, pass_rvtt_fix_ebreak);
INSERT_PASS_AFTER (pass_late_combine, 1, pass_rvtt_rmext);
INSERT_PASS_BEFORE (pass_postreload, 1, pass_rvtt_synth_opcode);
INSERT_PASS_BEFORE (pass_postreload, 1, pass_rvtt_schedule);
INSERT_PASS_AFTER (pass_postreload, 1, pass_rvtt_replay);

// This pass should run as late as possible, ideally just before final.
// However, the machine reorg pass, when using -msave-restore, injects an insn
// that causes df_analyze to crash, so run before that And, free_cfg pass calls
// free_bb_for_insn resulting in problems w/ df_analyze, so call before that
INSERT_PASS_BEFORE (pass_free_cfg, 1, pass_rvtt_hll);
INSERT_PASS_BEFORE (pass_free_cfg, 1, pass_rvtt_fix_raw);
