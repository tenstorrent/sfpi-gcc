/* The named refusals of the Tensix optimization passes, one row per name:

     RVTT_REFUSAL (ENUM_ID, "name-string")

   A pass that declines a transformation records why under one of these
   names (tt/rvtt-refuse.h); the name appears in the pass dump and in the
   -fopt-info-missed remark.  Names are lowercase, hyphenated and prefixed
   by their mechanism.  */

RVTT_REFUSAL (ALL_LANES_PROOF_MISSING, "all-lanes-proof-missing")
RVTT_REFUSAL (CC_ENABLE_UNPROVED, "cc-enable-unproved")
RVTT_REFUSAL (CC_RESTORE_STORE_RACE, "cc-restore-store-race")
RVTT_REFUSAL (CONSUMER_LANE_DISCIPLINE_UNAUDITED, "consumer-lane-discipline-unaudited")
RVTT_REFUSAL (CONTROL_FLOW, "control-flow")
RVTT_REFUSAL (COUNTED_CAPTURE_PEEL, "counted-capture-peel")
RVTT_REFUSAL (COUNTED_CAPTURE_PEEL_BENEFIT, "counted-capture-peel-benefit")
RVTT_REFUSAL (COUNTED_CAPTURE_PEEL_TRIPS_UNPROVEN, "counted-capture-peel-trips-unproven")
RVTT_REFUSAL (CROSSCALL_CALLER_CONFIG_WORD_UNPROVEN, "crosscall-caller-config-word-unproven")
RVTT_REFUSAL (CROSSCALL_CALLER_REPLAY_UNPROVEN, "crosscall-caller-replay-unproven")
RVTT_REFUSAL (CROSSCALL_CALLER_WORD_UNPROVEN, "crosscall-caller-word-unproven")
RVTT_REFUSAL (CROSSLOOP_CC_ATOM_UNPROVEN, "crossloop-cc-atom-unproven")
RVTT_REFUSAL (CROSSLOOP_CC_PEEL_ENTRYCC_UNPROVEN, "crossloop-cc-peel-entrycc-unproven")
RVTT_REFUSAL (CROSSROW_PAIRING_RENAME_CC_DOMAIN, "crossrow-pairing-rename-cc-domain")
RVTT_REFUSAL (DEBUG_REGS_WRITE_UNPROVEN, "debug-regs-write-unproven")
RVTT_REFUSAL (DEF_USE, "def-use")
RVTT_REFUSAL (DELIVERY_SHAPE_EXEC_TERM_UNAUDITED, "delivery-shape-exec-term-unaudited")
RVTT_REFUSAL (DERIVED_STRIDE_ABSORPTION_UNPROVEN, "derived-stride-absorption-unproven")
RVTT_REFUSAL (DRAIN_INIT_OWNERSHIP_UNPROVEN, "drain-init-ownership-unproven")
RVTT_REFUSAL (DUALBANK_PIN_SHAPE_UNMODELED, "dualbank-pin-shape-unmodeled")
RVTT_REFUSAL (EFFECT_OPAQUE, "effect-opaque")
RVTT_REFUSAL (GLOBAL_POINTER_VALUE_UNPROVEN, "global-pointer-value-unproven")
