RVTT_REFUSAL (INIT_HOIST_COMMIT_DIVERGED, "init-hoist-commit-diverged")
RVTT_REFUSAL (LAUNCH_FLATTEN_FUNCTION_BUDGET, "launch-flatten-function-budget")
RVTT_REFUSAL (LIVE_IN, "live-in")
RVTT_REFUSAL (LREG_FILE_EXHAUSTED, "lreg-file-exhausted")
RVTT_REFUSAL (MADPAIR_PRGM_EXHAUSTED, "madpair-prgm-exhausted")
RVTT_REFUSAL (MOD_WRITE_DOMINATES_ROLLED_BODY, "mod-write-dominates-rolled-body")
RVTT_REFUSAL (MOP_CALLER_TEMPLATE_LIVE_UNPROVEN, "mop-caller-template-live-unproven")
RVTT_REFUSAL (MOP_TEMPLATE_REPLAY_UNPROVEN, "mop-template-replay-unproven")
