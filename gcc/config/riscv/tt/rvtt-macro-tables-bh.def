/* Blackhole SFPLOADMACRO capability tables, consumed by
   rvtt-macro-tables.cc.  Raw words below are known descriptor programs
   (Min/Max, signbit, cast/round, select); field layouts follow the TT_OP_*
   field tables (sfpu-ops-bh.h).  Descriptor-state words (templates,
   sequences, misc) are common to WH and BH; they appear in both .def files
   and a unit test checks that the two tables agree.  */

/* CPU scalars.
   Launch layout: 0x93 << 24 | lreg_ind << 20 | instr_mod0 << 16
     | addr_mode << 13 | dest_reg_addr    (lreg_ind = macro_index*4 + vd).
   The BH addr_mode field is 3 bits at 15:13, directly below InstrMod0 at
   bit 16, matching the BH SFPLOAD/SFPSTORE layouts (sfpu-ops-bh.h:
   addr_mode << 13) and the TT-Metal LLK (tt_llk_blackhole
   common/inc/ckernel_ops.h: TT_OP_SFPLOADMACRO << 13 with a 3-bit
   sfpu_addr_mode); WH uses a 2-bit field at 15:14.  dest_reg_addr is 10 bits (9:0).
   Address mode 7 performs no increment; mode 6 is the Dst += 2
   auto-increment.  The owned config dests are the whole LoadMacroConfig
   class {0..8} = 0x01ff: SFPCONFIG destinations 0-3
   (InstructionTemplate[0..3]), 4-7 (Sequence[0..3]) and 8 (Misc) form one
   architectural state class (SFPCONFIG.md, SFPLOADMACRO.md).  Owning a
   wider set only makes the checks for foreign accesses stricter.  Drain is
   3 slots.  The break-even row count is reference data for the cost-model
   tests, not a planner input.  */
XTT_MACRO_CAPS_SCALARS ("bh", /*n_templates*/4, /*n_sequence_slots*/4,
			/*delay_bits*/3,
			/*launch_opcode*/0x93, /*lreg_ind_shift*/20,
			/*mod0_shift*/16, /*addr_mode_shift*/13,
			/*addr_mode_bits*/3, /*address_bits*/10,
			/*no_inc*/7, /*auto_inc_dst2*/6,
			/*needs_bank_base_ownership*/false,
			/*setc16_opcode*/0xb2, /*sfpconfig_opcode*/0x91,
			/*owned_config_dests*/0x01ff,
			/*proven_drain_slots*/3,
			/*reference_breakeven_rows*/7)

/* BH names physical address-modifier slot six directly in the launch's
   3-bit field.  SETC16 regs 18/34/53 own slot 6's Src increment+clear,
   Dst increment, fidelity increment+bias; values (0, 2, 0) program the
   Dst += 2 auto-increment from any incoming state.  The raw SETC16 words
   are 0xB2120000, 0xB2220002, 0xB2350000.  */
XTT_MACRO_ADDR_MOD_SLOT (/*phys*/6, /*src*/18, 0, /*dst*/34, 2,
			 /*fid*/53, 0)

/* Full owned SETC16 program (reference expectation, order as emitted).  */
XTT_MACRO_REF_ADDR_MOD_SETC16 (18, 0)
XTT_MACRO_REF_ADDR_MOD_SETC16 (34, 2)
XTT_MACRO_REF_ADDR_MOD_SETC16 (53, 0)

/* WH/BH-common sequence programs (SFPCONFIG dest = 4 + macro).  The
   bit-level word format is not documented, so words are used whole.
   Delays are the documented values, or DELAY_UNKNOWN (255) where the
   documentation does not state the per-event delay.  */

/* Min/Max macro 0: launches the SFPSWAP template (word to dest 4).
   Single templated event, no store.  */
XTT_MACRO_SEQ_PROGRAM ("minmax-binary-m0", 0, 0x00dd008c, 1,
		       SU_SIMPLE, 0, 255, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false)

/* Min/Max macro 1: SHFT2 copy into macro LReg16 plus the delayed store
   absorbing the Dst increment (word to dest 5).  Max elapsed delay
   three slots.  */
XTT_MACRO_SEQ_PROGRAM ("minmax-binary-m1", 1, 0x53000000, 2,
		       SU_SIMPLE, 1, 255, false,
		       SU_STORE, -1, 255, true,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false)

/* Signbit macro 0: shift (template 0), cast (template 1), delayed store
   (dest 4).  The final delayed store retires three issue slots after
   launch -> store delay 3.  Unit assignment of the cast to Simple
   follows the cast-round shape's documented "Simple d0" (an
   inference).  */
XTT_MACRO_SEQ_PROGRAM ("signbit-m0", 0, 0x5384004d, 3,
		       SU_SIMPLE, 0, 255, false,
		       SU_SIMPLE, 1, 255, false,
		       SU_STORE, -1, 3, true,
		       SU_NONE, -1, 0, false)

/* Cast/round macro 0: "Simple d0, Round d1, Store d2" (dest 4).  The
   one shape with fully documented per-event delays.  */
XTT_MACRO_SEQ_PROGRAM ("cast-round-m0", 0, 0x534d0004, 3,
		       SU_SIMPLE, 0, 0, false,
		       SU_ROUND, 1, 1, false,
		       SU_STORE, -1, 2, true,
		       SU_NONE, -1, 0, false)

/* Select macro 0: "SETCC d0, store d2" (dest 4).  */
XTT_MACRO_SEQ_PROGRAM ("select-m0", 0, 0x13000004, 2,
		       SU_SIMPLE, 0, 0, false,
		       SU_STORE, -1, 2, true,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false)

/* Select macro 1: idle middle sequence (dest 5).  */
XTT_MACRO_SEQ_PROGRAM ("select-m1-idle", 1, 0x00000000, 0,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false)

/* Select macro 2: "ENCC d0" (dest 6).  */
XTT_MACRO_SEQ_PROGRAM ("select-m2", 2, 0x00000005, 1,
		       SU_SIMPLE, 1, 0, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false)

/* Select restore on macro 1 (dest 5): the derived select calendar
   demotes the hostless middle payload carrier to a plain SFPLOAD (two
   launches plus an explicit load, as in the TT-Metal Where kernel), so
   the all-lanes-restore ENCC event rides the last launch as macro 1
   rather than macro 2.  The word is the "ENCC d0" program above; the
   macro index only selects the SFPCONFIG destination (4 + K), which the
   word does not encode.  */
XTT_MACRO_SEQ_PROGRAM ("select-m1-encc", 1, 0x00000005, 1,
		       SU_SIMPLE, 1, 0, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false)

/* Misc words (SFPCONFIG dest 8).  */

XTT_MACRO_MISC_WORD ("minmax-binary", 0x00000330, false, 0)  /* Min/Max.  */
XTT_MACRO_MISC_WORD ("signbit",	      0x00000110, false, 0)  /* Signbit.  */
XTT_MACRO_MISC_WORD ("cast-round",    0x00000100, false, 0)  /* Cast/round.  */
/* Select: 0x700 | StoreMod0, with StoreMod0 = 6.  */
XTT_MACRO_MISC_WORD ("select-u16",    0x00000706, true, 6)
/* Select, launch-sourced store mod0 (compact 3-slot calendar): the
   misc word used by the TT-Metal Where kernel (ckernel_sfpu_where.h
   _init_where_: TTI_SFPCONFIG(0x770, 8, 1), "{UsesLoadMod0ForStore=1,
   WaitForElapsedInstructions=1} for all macros"; bit 4+macro selects the
   launch's own instr_mod0 as the delayed store's format).  The bit layout
   above 3:0 is not documented, so the word is used whole; bits 3:0 are
   ignored under launch sourcing.  */
XTT_MACRO_MISC_WORD ("select-launch-mod0", 0x00000770, false, 0)

/* Hidden template LREG writes.  */

/* The Min/Max SFPSWAP template (0x920002cX, any mod1) writes physical L2:
   modeled in the RTL as `(clobber (reg:XTT32SI 82))` on
   rvtt_sfploadmacro_swap_int (rvtt.md; 82 = SFPU_REG_FIRST (80) + 2).  */
XTT_MACRO_HIDDEN_WRITE (0x920002c0, 0xfffffff0, /*L2*/ (1u << 2))

/* Reference descriptor-word sets for the unit tests.  */

/* Min/Max.  dest0 = SFPSWAP template
   0x920002c0|mod: SFPSWAP(imm12=0, VC=L2, VD=selector 0xC, mod1=mod);
   mod 1 places min in VD, mod 9 places max.  dest1 =
   0x940000d6: SFPSHFT2(imm12=0, src 0, dest=selector 0xD, mod1=6),
   "SHFT2 copy into macro LReg16".  */
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-min", 0, 0x920002c1)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-min", 1, 0x940000d6)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-min", 4, 0x00dd008c)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-min", 5, 0x53000000)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-min", 8, 0x00000330)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-max", 0, 0x920002c9)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-max", 1, 0x940000d6)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-max", 4, 0x00dd008c)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-max", 5, 0x53000000)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-max", 8, 0x00000330)

/* Signbit.  dest0 = 0x94fe10c6: SFPSHFT2(imm12=0xfe1 = -31,
   src 0, dest=selector 0xC, mod1=6); dest1 = 0x900000d0: SFPCAST(src 0,
   dest=selector 0xD, mod1=0).  */
XTT_MACRO_REF_DESCRIPTOR ("signbit", 0, 0x94fe10c6)
XTT_MACRO_REF_DESCRIPTOR ("signbit", 1, 0x900000d0)
XTT_MACRO_REF_DESCRIPTOR ("signbit", 4, 0x5384004d)
XTT_MACRO_REF_DESCRIPTOR ("signbit", 8, 0x00000110)

/* Cast/round.  dest0 = 0x900000c0: SFPCAST(src 0,
   dest=selector 0xC, mod1=0); dest1 = 0x8e0000d1: SFP_STOCH_RND(all
   upper fields 0, src_c 0, dest=selector 0xD, mod1=1).  */
XTT_MACRO_REF_DESCRIPTOR ("cast-round", 0, 0x900000c0)
XTT_MACRO_REF_DESCRIPTOR ("cast-round", 1, 0x8e0000d1)
XTT_MACRO_REF_DESCRIPTOR ("cast-round", 4, 0x534d0004)
XTT_MACRO_REF_DESCRIPTOR ("cast-round", 8, 0x00000100)

/* Predicated select.  dest0 = 0x7b0000c6:
   SFPSETCC(imm12=0, src 0, dest=selector 0xC, mod1=6) "loaded value ==
   zero"; dest1 = 0x8a0000d0: SFPENCC(imm12=0, src 0, dest=selector 0xD,
   mod1=0) "restore all lanes".  */
XTT_MACRO_REF_DESCRIPTOR ("select-u16", 0, 0x7b0000c6)
XTT_MACRO_REF_DESCRIPTOR ("select-u16", 1, 0x8a0000d0)
XTT_MACRO_REF_DESCRIPTOR ("select-u16", 4, 0x13000004)
XTT_MACRO_REF_DESCRIPTOR ("select-u16", 5, 0x00000000)
XTT_MACRO_REF_DESCRIPTOR ("select-u16", 6, 0x00000005)
XTT_MACRO_REF_DESCRIPTOR ("select-u16", 8, 0x00000706)
