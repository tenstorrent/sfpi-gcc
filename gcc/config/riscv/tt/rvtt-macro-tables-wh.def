/* X-macro data consumed by rvtt-macro-tables.cc.  Transcribed from the
   frozen Min/Max pass (4e045d31d, rtl-rvtt-loadmacro.cc) and
   sfpu-ops-wh.h; provenance per constant in NOTES-wp6-prep.md.
   Descriptor-state words (templates, sequences, misc) are WH/BH-COMMON by
   test evidence (loadmacro-periodic-minmax-wh.C asserts the identical
   SFPCONFIG words as the BH test); the unit test asserts the two .def
   files never diverge on them.  Only the launch-field layout and the
   address-modifier plumbing are WH-specific.  */

/* CPU scalars.
   Launch layout: 0x93 << 24 | lreg_ind << 20 | instr_mod0 << 16
     | addr_mode << 14 | dest_reg_addr    (lreg_ind = macro_index*4 + vd),
   matching TT_OP_WH_SFPLOADMACRO (sfpu-ops-wh.h:256-257) and the frozen
   pass (rtl-rvtt-loadmacro.cc:1001: WH shift 14; 2-bit field).
   No-increment addr mode 3 (:442,579,717,1489); Dst += 2 auto-increment
   addr mode 2 (:503,619,1024-1025).  Owned config dests {0,1,4,5,6,8}
   (:164-169) = 0x0173.  Drain 3 slots.  Break-even 8 rows (:1123) --
   the FROZEN pass's dual-slot figure, reference data for the WP7
   cost-model regression only and never a planner input; the corrected
   single-slot program (below) makes the planner's derived break-even
   7 rows, mirroring BH (loadmacro-periodic-minmax-seven-wh.C).  */
XTT_MACRO_CAPS_SCALARS ("wh", /*n_templates*/4, /*n_sequence_slots*/4,
			/*delay_bits*/3,
			/*launch_opcode*/0x93, /*lreg_ind_shift*/20,
			/*mod0_shift*/16, /*addr_mode_shift*/14,
			/*addr_mode_bits*/2, /*address_bits*/10,
			/*no_inc*/3, /*auto_inc_dst2*/2,
			/*needs_bank_base_ownership*/true,
			/*setc16_opcode*/0xb2, /*sfpconfig_opcode*/0x91,
			/*owned_config_dests*/0x01ff,
			/*proven_drain_slots*/3,
			/*reference_breakeven_rows*/8)

/* WH's two-bit launch field names the physical slot THROUGH the bank
   base bit (ADDR_MOD_SET_Base, thread configuration address 2):
   modifier m selects physical slot m under Base=0 and slot m+4 under
   Base=1.  The SFPU platform contract pins Base=1 while compiled SFPI
   code executes -- every LLK SFPU entry sequence brackets the kernel
   body (tt-llk wormhole_b0 cmath_common.h set/clear_addr_mod_base,
   invoked from _llk_math_eltwise_sfpu_start_/_done_ and peers), and the
   LLK states the aliasing invariant outright ("with addr_mod_base=1,
   insn ADDR_MOD_3 -> phys ADDR_MOD_7 (SFPU invariant)",
   ckernel_sfpu_topk.h).  So the calendar owns exactly ONE physical
   slot: scratch modifier 2 under Base=1 = physical slot 6, SETC16 regs
   19/29/54; values (0,2,0) = zero Src increment/clear, Dst increment
   two, zero fidelity increment/bias.

   The base-0 bank must never be written: physical slot 2 (SETC16 regs
   11/25/50) is LLK's ADDR_MOD_2, consumed with live strides by the
   base-0 FPU/datacopy path of the loops that host transformed SFPI
   kernels (llk_math_eltwise_unary_datacopy.h MOV_8_ROWS, Dst+8).  The
   historical dual-slot program (transcribed from the frozen pass,
   rtl-rvtt-loadmacro.cc:834-843) wrote both banks and corrupted every
   tile after the first; the WH dst-autoincr hardware adjudication
   convicted the compiler and the corrected reference simulator
   reproduced the corruption.  The WH position-shuffled formed-calendar
   failure (hardware trace) was this same mechanism.  Raw words
   asserted by loadmacro-periodic-minmax-wh.C.  */
XTT_MACRO_ADDR_MOD_SLOT (/*phys*/6, /*src*/19, 0, /*dst*/29, 2,
			 /*fid*/54, 0)

/* Full owned SETC16 program (reference expectation): the single
   Base=1 slot, three words.  */
XTT_MACRO_REF_ADDR_MOD_SETC16 (19, 0)
XTT_MACRO_REF_ADDR_MOD_SETC16 (29, 2)
XTT_MACRO_REF_ADDR_MOD_SETC16 (54, 0)

/* ------------------------------------------------------------------ */
/* WH/BH-common proven data: byte-for-byte the BH entries; see the     */
/* provenance comments in rvtt-macro-tables-bh.def.		       */
/* ------------------------------------------------------------------ */

XTT_MACRO_SEQ_PROGRAM ("minmax-binary-m0", 0, 0x00dd008c, 1,
		       SU_SIMPLE, 0, 255, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false)
XTT_MACRO_SEQ_PROGRAM ("minmax-binary-m1", 1, 0x53000000, 2,
		       SU_SIMPLE, 1, 255, false,
		       SU_STORE, -1, 255, true,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false)
XTT_MACRO_SEQ_PROGRAM ("signbit-m0", 0, 0x5384004d, 3,
		       SU_SIMPLE, 0, 255, false,
		       SU_SIMPLE, 1, 255, false,
		       SU_STORE, -1, 3, true,
		       SU_NONE, -1, 0, false)
XTT_MACRO_SEQ_PROGRAM ("cast-round-m0", 0, 0x534d0004, 3,
		       SU_SIMPLE, 0, 0, false,
		       SU_ROUND, 1, 1, false,
		       SU_STORE, -1, 2, true,
		       SU_NONE, -1, 0, false)
XTT_MACRO_SEQ_PROGRAM ("select-m0", 0, 0x13000004, 2,
		       SU_SIMPLE, 0, 0, false,
		       SU_STORE, -1, 2, true,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false)
XTT_MACRO_SEQ_PROGRAM ("select-m1-idle", 1, 0x00000000, 0,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false)
XTT_MACRO_SEQ_PROGRAM ("select-m2", 2, 0x00000005, 1,
		       SU_SIMPLE, 1, 0, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false)

/* Select restore on macro ONE (dest 5): the derived select calendar's
   last-launch ENCC event -- see the provenance note in the BH file
   (the two tables never diverge on descriptor-state words; the unit
   test asserts it).  */
XTT_MACRO_SEQ_PROGRAM ("select-m1-encc", 1, 0x00000005, 1,
		       SU_SIMPLE, 1, 0, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false,
		       SU_NONE, -1, 0, false)

XTT_MACRO_MISC_WORD ("minmax-binary", 0x00000330, false, 0)
XTT_MACRO_MISC_WORD ("signbit",	      0x00000110, false, 0)
XTT_MACRO_MISC_WORD ("cast-round",    0x00000100, false, 0)
XTT_MACRO_MISC_WORD ("select-u16",    0x00000706, true, 6)
/* Select, launch-sourced store mod0 (WP10 compact 3-slot calendar):
   the shipped handwritten Where protocol's own misc word
   (tt-metal ckernel_sfpu_where.h _init_where_: TTI_SFPCONFIG(0x770, 8, 1),
   "{UsesLoadMod0ForStore=1, WaitForElapsedInstructions=1} for all
   macros"; simulator tensix.cpp: bit 4+macro selects the launch's own
   instr_mod0 as the delayed store's format).  Carried as a proven
   whole word per Sec. 3 of docs/MACRO_PLANNER.md -- the bit layout
   above 3:0 remains architecturally unestablished; bits 3:0 are inert
   under launch sourcing.  */
XTT_MACRO_MISC_WORD ("select-launch-mod0", 0x00000770, false, 0)

XTT_MACRO_HIDDEN_WRITE (0x920002c0, 0xfffffff0, /*L2*/ (1u << 2))

XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-min", 0, 0x920002c1)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-min", 1, 0x940000d6)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-min", 4, 0x00dd008c)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-min", 5, 0x53000000)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-min", 8, 0x00000330)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-max", 0, 0x920002c9)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-max", 1, 0x940000d6)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-max", 4, 0x00dd008c)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-max", 5, 0x53000000)
XTT_MACRO_REF_DESCRIPTOR ("minmax-binary-max", 8, 0x00000330)
XTT_MACRO_REF_DESCRIPTOR ("signbit", 0, 0x94fe10c6)
XTT_MACRO_REF_DESCRIPTOR ("signbit", 1, 0x900000d0)
XTT_MACRO_REF_DESCRIPTOR ("signbit", 4, 0x5384004d)
XTT_MACRO_REF_DESCRIPTOR ("signbit", 8, 0x00000110)
XTT_MACRO_REF_DESCRIPTOR ("cast-round", 0, 0x900000c0)
XTT_MACRO_REF_DESCRIPTOR ("cast-round", 1, 0x8e0000d1)
XTT_MACRO_REF_DESCRIPTOR ("cast-round", 4, 0x534d0004)
XTT_MACRO_REF_DESCRIPTOR ("cast-round", 8, 0x00000100)
XTT_MACRO_REF_DESCRIPTOR ("select-u16", 0, 0x7b0000c6)
XTT_MACRO_REF_DESCRIPTOR ("select-u16", 1, 0x8a0000d0)
XTT_MACRO_REF_DESCRIPTOR ("select-u16", 4, 0x13000004)
XTT_MACRO_REF_DESCRIPTOR ("select-u16", 5, 0x00000000)
XTT_MACRO_REF_DESCRIPTOR ("select-u16", 6, 0x00000005)
XTT_MACRO_REF_DESCRIPTOR ("select-u16", 8, 0x00000706)
