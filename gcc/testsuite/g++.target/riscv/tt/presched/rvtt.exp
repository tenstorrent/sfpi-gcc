# Pre-RA pressure-cost list scheduler twins.  Raw-builtin tests
# (raw-*.C) need no headers and always run; sfpi-dialect tests
# (sfpi-*.C) need the SFPI headers and are skipped silently when the
# SFPI environment variable is unset (same contract as tt/sfpi).

# Exit immediately if this isn't a RISC-V target.
if ![istarget riscv-tt-elf] then {
  return
}

# Load support procs.
load_lib g++-dg.exp

# Initialize `dg'.
dg-init

# Raw-builtin arsenal: no external headers.
dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/raw-*.C]] "" ""

# sfpi-dialect arsenal: headers at $SFPI/include.
if [info exists env(SFPI)] {
  proc SFPI {} {
    global env
    return $env(SFPI)
  }
  dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/sfpi-*.C]] "" ""
}

# All done.
dg-finish
