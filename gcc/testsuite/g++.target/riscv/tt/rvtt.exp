# GCC testsuite that uses the `dg.exp' driver.

# Exit immediately if this isn't a RISC-V target.

# FIXME: Ideally we'd've stamped these as riscv*-tt-*, but alas
# not. In lieu of that test the compiler for the tt variants.

if ![istarget riscv-tt-elf] then {
  return
}

# Load support procs.
load_lib g++-dg.exp

# Initialize `dg'.
dg-init

# Main loop.
dg-runtest [lsort [glob -nocomplain $srcdir/$subdir/*.C]] "" ""

# Pressure-scheduler tests use the SFPI headers but must still be reached by
# check-gcc-tt, whose RUNTESTFLAGS selects this driver explicitly.  Do not glob
# the whole legacy sfpi directory here; keep this opt-in suite focused.
if [info exists env(SFPI)] {
  proc SFPI {} {
    global env
    return $env(SFPI)
  }

  set pressure_tests [concat \
    [glob -nocomplain $srcdir/$subdir/sfpi/lp-schedule-*.C] \
    [glob -nocomplain $srcdir/$subdir/sfpi/pressure-schedule-*.C] \
    [glob -nocomplain $srcdir/$subdir/sfpi/welford-pressure-*.C]]
  dg-runtest [lsort $pressure_tests] "" ""
}

# All done.
dg-finish
